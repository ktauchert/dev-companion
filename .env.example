POSTGRES_DB=devcompanion
POSTGRES_USER=devcompanion
POSTGRES_PASSWORD=devcompanion
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Better Auth (AP 1.3 — nicht committen; Secret ≥ 32 Zeichen)
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3141

# Kein POSTGRES_URL / DATABASE_URL in .env — die Verbindungs-URL baut
# packages/database (getDatabaseUrl) aus den POSTGRES_*-Teilen.
# Optional: DATABASE_URL zur Laufzeit (CI/Prod) überschreibt die Teile.
